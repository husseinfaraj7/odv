# =============================================================================
# ODV Sicilia Backend - Environment Variables
# =============================================================================
# ⚠️  SECURITY WARNING - READ THIS FIRST ⚠️
# =============================================================================
# 
# THIS IS A TEMPLATE FILE (.env.example) - IT IS SAFE TO COMMIT TO VERSION CONTROL
# 
# ⚠️  NEVER add real credentials, API keys, or secrets to this file!
# ⚠️  This file should ONLY contain placeholder/example values for documentation.
# 
# HOW TO USE:
# 1. Copy this file to create a NEW file named ".env" (without .example)
# 2. Add your REAL credentials to the ".env" file (NOT this file)
# 3. The ".env" file is in .gitignore and MUST NEVER be committed to git
# 
# PRODUCTION DEPLOYMENT:
# ⚠️  NEVER hardcode real credentials in any committed file!
# ⚠️  Configure all sensitive values as environment variables in your deployment 
#    platform (e.g., Render, Heroku, AWS, etc.) using their dashboard/CLI.
# ⚠️  Do NOT copy the .env file to production servers.
# 
# =============================================================================
# Copy this file to .env and fill in your values
# For local development, most variables are optional - see below

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
# Server port (optional, defaults to 8080)
PORT=8080

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# OPTIONAL FOR LOCAL DEVELOPMENT:
# If not set, the application will use H2 in-memory database when running
# with the 'dev' profile. This is the recommended approach for local development.
#
# To use a local PostgreSQL database instead, uncomment and configure:
# DATABASE_URL=jdbc:postgresql://localhost:5432/odvsicilia
# DATABASE_USER=postgres
# ⚠️  SECURITY: Never commit real passwords! Use placeholder here, set real value in:
#    - Local: your private .env file (NOT .env.example)
#    - Production: environment variables in your hosting platform (e.g., Render dashboard)
# DATABASE_PASSWORD=yourpassword
#
# Alternative: Use individual database parameters
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_NAME=odvsicilia
# DATABASE_USER=postgres
# ⚠️  SECURITY: Never commit real passwords! Use placeholder here, set real value in:
#    - Local: your private .env file (NOT .env.example)
#    - Production: environment variables in your hosting platform (e.g., Render dashboard)
# DATABASE_PASSWORD=yourpassword
#
# Schema management (optional, defaults to 'validate')
# DDL_AUTO=update

# =============================================================================
# EMAIL CONFIGURATION (Brevo SMTP)
# =============================================================================
# REQUIRED for sending emails (contact form, order notifications, etc.)
# Get your API key from: https://app.brevo.com/settings/keys/api
#
# ⚠️  SECURITY - SENSITIVE CREDENTIAL:
# This is a SECRET API key that grants access to your Brevo account!
# - Local dev: Set real value ONLY in your private .env file (NOT this .env.example)
# - Production: Configure as environment variable in Render/hosting platform dashboard
# - NEVER commit the real API key to version control
BREVO_API_KEY=your_brevo_api_key_here

# SMTP Configuration (optional, defaults provided)
# BREVO_SMTP_SERVER=smtp-relay.brevo.com
# BREVO_SMTP_PORT=587
# BREVO_SMTP_USERNAME=96f5ae002@smtp-brevo.com

# Email sender information (optional, defaults provided)
# BREVO_SENDER_EMAIL=noreply@odvsicilia.it
# BREVO_SENDER_NAME=ODV Sicilia

# Admin email for receiving contact form submissions (optional)
# ADMIN_EMAIL=admin@odvsicilia.it

# =============================================================================
# SUPABASE CONFIGURATION
# =============================================================================
# OPTIONAL for local development if not using Supabase features
# Get these from your Supabase project settings: https://app.supabase.com
# SUPABASE_URL=https://your-project.supabase.co
#
# ⚠️  SECURITY - SENSITIVE CREDENTIAL:
# This anon key provides limited access to your Supabase project.
# - Local dev: Set real value ONLY in your private .env file (NOT this .env.example)
# - Production: Configure as environment variable in Render/hosting platform dashboard
# - NEVER commit the real key to version control
# SUPABASE_ANON_KEY=your_anon_key_here
#
# ⚠️  SECURITY - HIGHLY SENSITIVE CREDENTIAL:
# This service role key has FULL ADMIN access to your Supabase project!
# - Local dev: Set real value ONLY in your private .env file (NOT this .env.example)
# - Production: Configure as environment variable in Render/hosting platform dashboard
# - NEVER commit the real key to version control or expose it publicly
# SUPABASE_ROLE_KEY=your_service_role_key_here

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
# Frontend URL for CORS and email links (optional)
# FRONTEND_URL=http://localhost:3000

# =============================================================================
# H2 CONSOLE
# =============================================================================
# Enable H2 console for development (optional, defaults to true)
# Access at: http://localhost:8080/h2-console
# H2_CONSOLE_ENABLED=true

# =============================================================================
# PRODUCTION ONLY
# =============================================================================
# These are only needed for production deployments:
# CORS_ALLOWED_ORIGINS=https://odvsicilia.it,https://www.odvsicilia.it
